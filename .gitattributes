# Normalize line endings: LF in the repo, native in working trees
* text=auto

# Sources and config are always LF
*.ts text
*.tsx text
*.js text
*.json text
*.css text
*.html text
*.md text
*.jsonc text

# Windows scripts
*.bat text eol=crlf

# Binaries
*.png binary
*.jpg binary
*.svg text
*.woff2 binary
*.ico binary
